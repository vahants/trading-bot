# Copy to .env and fill in.  NEVER commit .env.  Secrets live here only.

# ---- mode ----
MODE=paper                 # paper | live   (start with paper!)

# ---- database / cache ----
DATABASE_URL=postgresql+psycopg2://trader:trader@localhost:5432/trading_bot
REDIS_URL=redis://localhost:6379/0

# ---- Bybit API ----
# Use TESTNET keys first. Disable withdrawals + enable IP allow-list on the key.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
BYBIT_CATEGORY=linear       # linear = USDT perpetuals

# ---- risk (fractions of equity) ----
RISK_PER_TRADE=0.005        # 0.5%
DAILY_MAX_LOSS=0.02         # 2%
WEEKLY_MAX_LOSS=0.05        # 5%
MAX_OPEN_POSITIONS=3
MAX_LEVERAGE=3
MAX_CONSECUTIVE_LOSSES=4
CIRCUIT_BREAKER_ATR_MULT=4  # 1-bar move > 4*ATR => freeze

# ---- trading ----
SYMBOLS=BTCUSDT,ETHUSDT
BASE_TIMEFRAME=60           # minutes (1h) for the MVP strategy
MIN_AI_SCORE=55             # trades scoring below this are skipped
STRATEGY=ema_rsi            # ema_rsi | donchian | bb_meanrev (see app/strategies/registry.py)

# ---- alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
